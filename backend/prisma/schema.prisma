generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StaffRole {
  SUPER_ADMIN
  MANAGER
  KITCHEN_STAFF
  DELIVERY_STAFF
  ACCOUNTANT
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CASH_ON_DELIVERY
  BKASH
  NAGAD
  VISA
  MASTERCARD
  AMERICAN_EXPRESS
  BANK_TRANSFER
  QR_PAYMENT
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  role         StaffRole?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer      Customer?
  auditLogs     AuditLog[]
  notifications Notification[]
  cart          Cart?
  passwordResetTokens PasswordResetToken[]
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses     CustomerAddress[]
  orders        Order[]
  favourites    Favourite[]
  reviews       Review[]
  notifications Notification[]
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  label      String
  address    String
  building   String?
  roomNumber String?
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveryOrders Order[]
}

model MenuCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MenuItem[]
}

model MenuItem {
  id           String   @id @default(cuid())
  categoryId   String
  name         String
  description  String?
  price        Decimal  @db.Decimal(12, 2)
  imageUrl     String?
  isVegetarian Boolean  @default(false)
  spiceLevel   Int      @default(1)
  isAvailable  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  options    FoodOption[]
  addons     FoodAddon[]
  favourites Favourite[]
  orderItems OrderItem[]
  cartItems  CartItem[]
}

model FoodOption {
  id            String  @id @default(cuid())
  menuItemId    String
  name          String
  priceModifier Decimal @db.Decimal(12, 2)
  isActive      Boolean @default(true)

  menuItem         MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]
}

model FoodAddon {
  id         String  @id @default(cuid())
  menuItemId String
  name       String
  price      Decimal @db.Decimal(12, 2)
  isActive   Boolean @default(true)

  menuItem    MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderAddons OrderItemAddon[]
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  customerId          String?
  orderType           OrderType
  status              OrderStatus   @default(NEW)
  subtotal            Decimal       @db.Decimal(12, 2)
  deliveryFee         Decimal       @default(0) @db.Decimal(12, 2)
  tax                 Decimal       @default(0) @db.Decimal(12, 2)
  serviceCharge       Decimal       @default(0) @db.Decimal(12, 2)
  discount            Decimal       @default(0) @db.Decimal(12, 2)
  total               Decimal       @db.Decimal(12, 2)
  couponCode          String?
  deliveryAddressId   String?
  specialInstructions String?
  scheduledAt         DateTime?
  paymentStatus       PaymentStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryAddress CustomerAddress?    @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payment         Payment?
  delivery        DeliveryAssignment?
  review          Review?
  notifications   Notification[]
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  menuItemId       String
  itemNameSnapshot String
  unitPrice        Decimal @db.Decimal(12, 2)
  quantity         Int
  subtotal         Decimal @db.Decimal(12, 2)

  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  options  OrderItemOption[]
  addons   OrderItemAddon[]
}

model OrderItemOption {
  id           String  @id @default(cuid())
  orderItemId  String
  optionId     String
  nameSnapshot String
  price        Decimal @db.Decimal(12, 2)
  quantity     Int     @default(1)

  orderItem OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    FoodOption @relation(fields: [optionId], references: [id], onDelete: Restrict)
}

model OrderItemAddon {
  id           String  @id @default(cuid())
  orderItemId  String
  addonId      String
  nameSnapshot String
  price        Decimal @db.Decimal(12, 2)
  quantity     Int     @default(1)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon     FoodAddon @relation(fields: [addonId], references: [id], onDelete: Restrict)
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  method        PaymentMethod
  gateway       String?
  transactionId String?
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("BDT")
  status        PaymentStatus @default(PENDING)
  metadata      Json?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DeliveryZone {
  id           String   @id @default(cuid())
  name         String   @unique
  minimumOrder Decimal  @default(0) @db.Decimal(12, 2)
  deliveryFee  Decimal  @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DeliveryRider {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  phone     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments DeliveryAssignment[]
}

model DeliveryAssignment {
  id               String    @id @default(cuid())
  orderId          String    @unique
  riderId          String
  status           String
  assignedAt       DateTime  @default(now())
  pickedUpAt       DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?

  order Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider DeliveryRider @relation(fields: [riderId], references: [id], onDelete: Restrict)
}

model Offer {
  id           String   @id @default(cuid())
  name         String
  type         String
  value        Decimal  @db.Decimal(12, 2)
  minimumOrder Decimal  @default(0) @db.Decimal(12, 2)
  startDate    DateTime
  endDate      DateTime
  usageLimit   Int?
  usedCount    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coupons Coupon[]
}

model Coupon {
  id        String   @id @default(cuid())
  offerId   String
  code      String   @unique
  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model Review {
  id             String       @id @default(cuid())
  customerId     String
  orderId        String       @unique
  foodRating     Int
  serviceRating  Int
  deliveryRating Int
  comment        String?
  status         ReviewStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reminders ReviewReminder[]
}

model ReviewReminder {
  id             String    @id @default(cuid())
  orderId        String
  customerId     String
  reminderNumber Int
  sentAt         DateTime?
  status         String
  createdAt      DateTime  @default(now())

  review Review @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@unique([orderId, reminderNumber])
}

model Favourite {
  id         String   @id @default(cuid())
  customerId String
  menuItemId String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([customerId, menuItemId])
}

model Notification {
  id         String              @id @default(cuid())
  userId     String?
  customerId String?
  orderId    String?
  type       String
  title      String
  message    String
  channel    NotificationChannel
  status     NotificationStatus  @default(PENDING)
  sentAt     DateTime?
  createdAt  DateTime            @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model RestaurantSetting {
  id                 String   @id @default(cuid())
  restaurantName     String
  phone              String?
  email              String?
  address            String?
  openingHours       Json?
  latitude           Decimal? @db.Decimal(10, 7)
  longitude          Decimal? @db.Decimal(10, 7)
  logoUrl            String?
  currency           String   @default("BDT")
  timezone           String   @default("Asia/Dhaka")
  deliveryEnabled    Boolean  @default(true)
  reservationEnabled Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIFAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIKnowledgeBase {
  id         String   @id @default(cuid())
  title      String
  content    String
  sourceType String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  menuItemId String
  quantity   Int      @default(1)
  price      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([cartId, menuItemId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


